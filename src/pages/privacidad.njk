---
pageKey: privacy
permalink: "{{ i18n.routes.privacy[lang] }}index.html"
---
{%- set t = i18n[lang] -%}
{%- set otherLang = 'en' if lang == 'es' else 'es' -%}
{%- set p = t.pages.privacy -%}
<div class="page-intro wrapper stack">
  <h1>{{ p.heading }}</h1>
  <p class="text-muted">{{ p.updated }}: <time datetime="{{ site.updated }}">{{ site.updated }}</time></p>
</div>

<div class="section section--tight">
  <div class="wrapper sidebar-layout sidebar-layout--toc">
    <nav class="toc" aria-labelledby="toc-titulo">
      <h2 id="toc-titulo" class="toc__title">{{ p.toc }}</h2>
      <ol class="toc__list">
        {%- for sec in p.sections %}
        <li><a href="#{{ sec.id }}">{{ sec.title }}</a></li>
        {%- endfor %}
      </ol>
    </nav>
    <div class="prose stack">
      {%- for sec in p.sections %}
      <section class="stack" aria-labelledby="{{ sec.id }}">
        <h2 id="{{ sec.id }}">{{ sec.title }}</h2>
        {%- for para in sec.body %}
        <p>{{ para }}</p>
        {%- endfor %}
      </section>
      {%- endfor %}
      {%- if site.email %}
      <p><a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
      {%- endif %}
    </div>
  </div>
</div>
