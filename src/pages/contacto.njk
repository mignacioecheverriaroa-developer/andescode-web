---
pageKey: contact
section: contact
permalink: "{{ i18n.routes.contact[lang] }}index.html"
---
{%- set t = i18n[lang] -%}
{%- set otherLang = 'en' if lang == 'es' else 'es' -%}
{%- set p = t.pages.contact -%}
{%- set f = p.form -%}
{%- set configured = site.formspreeId and site.email -%}
<div class="page-intro wrapper stack">
  <h1>{{ p.heading }}</h1>
  <p class="lead measure">{{ p.lead }}</p>
</div>

<section class="section section--tight">
  <div class="wrapper sidebar-layout sidebar-layout--form">
    {% include "contact-form.njk" %}
  </div>
</section>
