{%- set meta = t.pages[pageKey] -%}
{%- set pageTitle = metaTitle or meta.title -%}
{%- set pageDescription = metaDescription or meta.description -%}
{%- set canonical = (alternates[lang]) | url | absolute(site.url) -%}
{%- set ogImage = ('/assets/img/og/' + (ogSlug or (pageKey + '-' + lang)) + '.jpg') | url | absolute(site.url) -%}
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' {{ csp.themeHash }}; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://formspree.io; form-action 'self' https://formspree.io; base-uri 'self'; object-src 'none'; manifest-src 'self'; frame-src 'none'; worker-src 'none'; upgrade-insecure-requests">
<meta name="referrer" content="strict-origin-when-cross-origin">
<title>{{ pageTitle }}</title>
<meta name="description" content="{{ pageDescription }}">
{%- if noindex %}
<meta name="robots" content="noindex, follow">
{%- else %}
<link rel="canonical" href="{{ canonical }}">
{%- for code in i18n.langs %}
<link rel="alternate" hreflang="{{ i18n[code].locale }}" href="{{ alternates[code] | url | absolute(site.url) }}">
{%- endfor %}
<link rel="alternate" hreflang="x-default" href="{{ alternates.es | url | absolute(site.url) }}">
{%- endif %}
<meta name="color-scheme" content="light dark">
<meta name="theme-color" content="{{ site.themeColor.light }}" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="{{ site.themeColor.dark }}" media="(prefers-color-scheme: dark)">
<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:locale" content="{{ 'es_CL' if lang == 'es' else 'en_US' }}">
<meta property="og:locale:alternate" content="{{ 'en_US' if lang == 'es' else 'es_CL' }}">
<meta property="og:title" content="{{ pageTitle }}">
<meta property="og:description" content="{{ pageDescription }}">
<meta property="og:url" content="{{ canonical }}">
<meta property="og:image" content="{{ ogImage }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="{{ pageTitle }}">
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" href="{{ '/favicon.ico' | url }}" sizes="32x32">
<link rel="icon" href="{{ '/favicon.svg' | url }}" type="image/svg+xml">
<link rel="apple-touch-icon" href="{{ '/assets/icons/apple-touch-icon.png' | url }}">
<link rel="manifest" href="{{ '/site.webmanifest' | url }}">
<link rel="preload" href="{{ '/assets/fonts/archivo-var.woff2' | url }}" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="{% asset 'main.css' %}">
<script>{{ themeScript | safe }}</script>
<script type="module" src="{% asset 'main.js' %}"></script>
{% include "jsonld.njk" %}
