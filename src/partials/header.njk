<a class="skip-link" href="#contenido">{{ t.ui.skip }}</a>
<header class="site-header" id="top">
  <div class="site-header__inner wrapper">
    <a class="site-header__brand" href="{{ i18n.routes.home[lang] | url }}" aria-label="AndesCode, {{ t.nav.home | lower }}">
      {% inlineSvg "src/assets/brand/andescode-header.svg" %}
    </a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="menu-principal" hidden>
      <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="24" height="24"><path d="M4 7h16M4 12h16M4 17h16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      <span>{{ t.ui.menu }}</span>
    </button>
    <nav class="site-nav" id="menu-principal" aria-label="{{ t.ui.mainNav }}">
      <ul class="site-nav__list" role="list">
        <li class="site-nav__item site-nav__item--has-sub">
          <a class="site-nav__link" href="{{ i18n.routes.services[lang] | url }}"{% if section == 'services' %} aria-current="{{ 'page' if pageKey == 'services' else 'true' }}"{% endif %}>{{ t.nav.services }}</a>
          <button class="site-nav__sub-toggle" type="button" aria-expanded="false" aria-controls="submenu-servicios" hidden>
            <span class="visually-hidden">{{ t.ui.servicesSubmenu }}</span>
            <svg aria-hidden="true" focusable="false" viewBox="0 0 16 16" width="16" height="16"><path d="m4 6 4 4 4-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <ul class="site-nav__sub" id="submenu-servicios" role="list">
            {%- for s in services %}
            <li><a href="{{ s | serviceUrl(lang) | url }}"{% if serviceId == s.id %} aria-current="page"{% endif %}>{{ s[lang].short }}</a></li>
            {%- endfor %}
          </ul>
        </li>
        <li class="site-nav__item"><a class="site-nav__link" href="{{ i18n.routes.projects[lang] | url }}"{% if pageKey == 'projects' %} aria-current="page"{% endif %}>{{ t.nav.projects }}</a></li>
        <li class="site-nav__item"><a class="site-nav__link" href="{{ i18n.routes.about[lang] | url }}"{% if pageKey == 'about' %} aria-current="page"{% endif %}>{{ t.nav.about }}</a></li>
        <li class="site-nav__item"><a class="site-nav__link" href="{{ i18n.routes.contact[lang] | url }}"{% if pageKey == 'contact' %} aria-current="page"{% endif %}>{{ t.nav.contact }}</a></li>
      </ul>
      <div class="site-nav__tools cluster">
        <a class="lang-switch" href="{{ alternates[otherLang] | url }}" hreflang="{{ otherLang }}" lang="{{ otherLang }}">
          <span aria-hidden="true">{{ t.ui.langSwitchShort }}</span><span class="visually-hidden">{{ t.ui.langSwitch }}</span>
        </a>
        <button class="theme-toggle" type="button" hidden
          data-label="{{ t.ui.theme }}"
          data-auto="{{ t.ui.themeAuto }}" data-light="{{ t.ui.themeLight }}" data-dark="{{ t.ui.themeDark }}">
          <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="20" height="20"><circle cx="12" cy="12" r="8" fill="none" stroke="currentColor" stroke-width="2"/><path d="M12 4a8 8 0 0 1 0 16z" fill="currentColor"/></svg>
          <span class="theme-toggle__text">{{ t.ui.theme }}: {{ t.ui.themeAuto }}</span>
        </button>
      </div>
    </nav>
  </div>
</header>
